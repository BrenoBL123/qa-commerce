{
  "name": "qa-commerce",
  "version": "1.0.0",
  "description": "Projeto de simulação de aulas de QA",
  "main": "index.js",
  "scripts": {
    "start": "node src/server.js",
    "db": "node scripts/init_db.js",
    "cy:open": "cypress open",
    "test:web": "cypress run --spec \"cypress/e2e/web/**/*.feature\"",
    "test:api": "cypress run --spec \"cypress/e2e/api/**/*.feature\"",
    "test:all": "cypress run",
    "test:web:login": "cypress run --spec \"cypress/e2e/web/**/*.feature\" --expose tags=@login",
    "test:web:carrinho": "cypress run --spec \"cypress/e2e/web/**/*.feature\" --expose tags=@carrinho",
    "test:web:checkout": "cypress run --spec \"cypress/e2e/web/**/*.feature\" --expose tags=@checkout",
    "test:web:regressao": "cypress run --spec \"cypress/e2e/web/**/*.feature\" --expose tags=@regressao",
    "test:web:smoke": "cypress run --spec \"cypress/e2e/web/**/*.feature\" --expose tags=@smoke",
    "test:api:carrinho": "cypress run --spec \"cypress/e2e/api/**/*.feature\" --expose tags=@carrinho-api"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "body-parser": "^1.20.3",
    "express": "^4.21.2",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "open": "^10.1.0",
    "sqlite3": "^6.0.1",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1"
  },
  "allowScripts": {
    "sqlite3@6.0.1": true,
    "bcrypt@6.0.0": true,
    "cypress@16.1.1": true
  },
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^28.0.0",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "cypress": "^16.1.1",
    "esbuild": "^0.28.2"
  },
  "cypress-cucumber-preprocessor": {
    "stepDefinitions": [
      "cypress/e2e/[filepart]/step_definitions/**/*.js",
      "cypress/support/step_definitions/**/*.js"
    ],
    "filterSpecs": true,
    "omitFiltered": true
  }
}